# Copiar como .streamlit/secrets.toml (NO subir a git).

# ---------------------------------------------------------------
# Fuente de datos: "sqlite" (hoy) o "snowflake" (tras la migración)
# También se puede forzar con la variable de entorno FUENTE_DATOS.
# ---------------------------------------------------------------
[fuente]
tipo = "sqlite"
sqlite_dir = "."          # carpeta donde está EX14_VAREX_II.sqlite

# ---------------------------------------------------------------
# Snowflake: usado por st.connection("snowflake") cuando tipo = "snowflake"
# Requiere: pip install "snowflake-connector-python[pandas]"
# ---------------------------------------------------------------
[connections.snowflake]
account   = "xxxxxx-yyyyyy"
user      = "USUARIO"
authenticator = "externalbrowser"   # SSO; o use password = "..."
role      = "ROL_ANALITICA"
warehouse = "WH_ANALITICA"
database  = "ENERGIA"
schema    = "ION"
